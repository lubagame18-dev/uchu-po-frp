{$DOMAIN} {
    encode gzip
    header X-Content-Type-Options nosniff
    @api path /auth/v1/* /rest/v1/* /storage/v1/* /realtime/v1/* /functions/v1/* /graphql/v1*
    handle @api {
        reverse_proxy 127.0.0.1:8000
    }
    handle {
        respond "Not found" 404
    }
}
{$STUDIO_DOMAIN} {
    basicauth {
        {$STUDIO_USER} {$STUDIO_HASH}
    }
    reverse_proxy 127.0.0.1:8000
}
