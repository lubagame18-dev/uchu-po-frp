{
  "schema": "uchu.images.claude/1",
  "model": "claude",
  "role": "Поиск реальных изображений для базы знаний. Никакой генерации картинок.",
  "hard_rules": [
    "Не придумывать факты, подписи, годы, имена и названия. Брать только то, что есть в тексте таблицы или в проверенном источнике.",
    "Не генерировать изображения и не заменять их рисунками ИИ.",
    "Для каждого задания вернуть прямую ссылку на страницу источника, название изображения и лицензию/права.",
    "Если точного изображения нет — вернуть null, не подставлять похожее.",
    "Подпись на сайте печатает DeepSeek по полям caption; Claude не пишет подпись от себя."
  ],
  "allowed_sources": [
    "edu.gov.ru",
    "culture.ru",
    "prlib.ru",
    "histrf.ru",
    "rgo.ru",
    "mchs.gov.ru",
    "commons.wikimedia.org"
  ],
  "caption_contract": {
    "geography": "{map_title} · {region}",
    "literature": "{person_or_work}; {author_or_artist}, {year_if_known}",
    "history": "{full_name}, {life_years}, {role}"
  },
  "subjects": {
    "geography": {
      "policy": "real_maps_and_photos_only",
      "text_source": "knowledge-base/07_География/География. Таблицы, схемы, алгоритмы.md",
      "tasks": [
        {
          "id": "geo-coordinates",
          "topic": "Географические координаты",
          "need": "физическая карта мира или России с сеткой координат",
          "caption_fields": [
            "map_title",
            "region"
          ]
        },
        {
          "id": "geo-atmosphere",
          "topic": "Атмосфера и погода",
          "need": "климатическая карта или фото природного объекта",
          "caption_fields": [
            "map_title",
            "region"
          ]
        },
        {
          "id": "geo-climate",
          "topic": "Климатические пояса",
          "need": "официальная климатическая карта",
          "caption_fields": [
            "map_title",
            "region"
          ]
        },
        {
          "id": "geo-map",
          "topic": "Работа с картой",
          "need": "политико-административная или физическая карта",
          "caption_fields": [
            "map_title",
            "region"
          ]
        },
        {
          "id": "geo-object",
          "topic": "Географический объект",
          "need": "фотография природного объекта или карта региона",
          "caption_fields": [
            "map_title",
            "region"
          ]
        }
      ]
    },
    "literature": {
      "policy": "real_portraits_and_art_only",
      "text_source": "knowledge-base/02_Литература/Литература. Таблицы, схемы, алгоритмы.md",
      "tasks": [
        {
          "id": "lit-poem",
          "topic": "Анализ стихотворения",
          "need": "портрет автора или репродукция/иллюстрация к произведению",
